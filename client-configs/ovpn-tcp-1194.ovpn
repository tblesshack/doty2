setenv FRIENDLY_NAME "TBLESS tcp-1194"
client
dev tun
proto tcp
remote <SERVER_IP> 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth-user-pass
comp-lzo
verb 3
<ca>
