# Default options for sslh initscript
# sourced by /etc/init.d/sslh

# binary to use: forked (sslh) or single-thread (sslh-select) version
# systemd users: don't forget to modify /lib/systemd/system/ss
RUN=daemon
DAEMON=/usr/sbin/sslh
DAEMON_OPTS="-p 0.0.0.0:443 -p 0.0.0.0:9643 --ssh 127.0.0.1:22 --tls 127.0.0.1:8443"

